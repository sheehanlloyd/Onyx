/**
 * The product-identity half of a rename (D7, DEC-01), prepared and not applied.
 *
 *   node test/onyx/release/rename-product.mts --name <Name> [--repository <owner>/<name>] [--bundle-id <reverse.dns.id>] [--write]
 *
 * Without `--write` it prints what it would change and changes nothing. With
 * it, it rewrites the identity fields of product.json and nothing else. It
 * then lists what a rename also needs and no script should decide: the
 * user-facing strings, the theme extension, the documents, the icons and the
 * data migration. docs/naming/RENAME-PROCEDURE.md is the whole procedure.
 *
 * DEC-01 keeps internal identifiers: `onyx*` source names, setting and command
 * ids, the `.onyx/` folder in a repository and the `~/.onyx` data folder are
 * not touched here.
 */

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..', '..');

function argValue(flag: string): string | undefined {
	const index = process.argv.indexOf(flag);
	return index === -1 ? undefined : process.argv[index + 1];
}

const name = argValue('--name');
const repository = argValue('--repository');
const write = process.argv.includes('--write');
if (!name || !/^[A-Z][A-Za-z0-9]{2,15}$/.test(name) || (repository && !/^[A-Za-z0-9-]+\/[A-Za-z0-9._-]+$/.test(repository))) {
	console.error('usage: node test/onyx/release/rename-product.mts --name <Name> [--repository <owner>/<name>] [--bundle-id <reverse.dns.id>] [--write]\n  <Name>: one capitalised word of 3 to 16 letters or digits, for example Lydstone');
	process.exit(2);
}
const lower = name.toLowerCase();
const bundleId = argValue('--bundle-id') ?? `com.${lower}.editor`;

const productFile = path.join(repoRoot, 'product.json');
const before = fs.readFileSync(productFile, 'utf8');
const product = JSON.parse(before) as Record<string, unknown>;
const current = String(product.nameShort);
const currentLower = String(product.applicationName);
const currentRepository = /github\.com\/(?<repository>[^/]+\/[^/]+)\//.exec(String(product.reportIssueUrl))?.groups?.repository;

/** Identity fields and their new values. Data folder names are absent on purpose (DEC-01: `.onyx` is retained). */
const fields: Record<string, string> = {
	nameShort: name,
	nameLong: name,
	applicationName: lower,
	win32MutexName: lower,
	serverApplicationName: `${lower}-server`,
	tunnelApplicationName: `${lower}-tunnel`,
	win32DirName: name,
	win32NameVersion: name,
	win32RegValueName: name,
	win32AppUserModelId: `${name}.${name}`,
	win32ShellNameShort: `&${name}`,
	win32TunnelServiceMutex: `${lower}-tunnelservice`,
	win32TunnelMutex: `${lower}-tunnel`,
	darwinBundleIdentifier: bundleId,
	linuxDesktopName: lower,
	linuxIconName: lower,
	urlProtocol: lower,
};

let after = before;
const changes: string[] = [];
for (const [field, value] of Object.entries(fields)) {
	const pattern = new RegExp(`^(?<head>\\t"${field}": )"(?<old>[^"]*)"`, 'm');
	const match = pattern.exec(after);
	if (!match?.groups) {
		changes.push(`  MISSING  ${field} (not in product.json; add it by hand if this build needs it)`);
		continue;
	}
	if (match.groups.old !== value) {
		changes.push(`  ${field}: "${match.groups.old}" → "${value}"`);
		after = after.replace(pattern, `$<head>${JSON.stringify(value)}`);
	}
}
if (repository && currentRepository && repository !== currentRepository) {
	const occurrences = after.split(`github.com/${currentRepository}`).length - 1;
	changes.push(`  ${occurrences} URL(s): github.com/${currentRepository} → github.com/${repository}`);
	after = after.split(`github.com/${currentRepository}`).join(`github.com/${repository}`);
}
// The Windows application ids are GUIDs that identify the installed product. A renamed product is a different
// product to an installer; new ones are generated by hand when Windows is scheduled (M2), not here.

function count(pattern: string, ...paths: string[]): number {
	return countWith(['-E', pattern], paths);
}

/** Whole-word occurrences of a literal. */
function countWord(word: string, ...paths: string[]): number {
	return countWith(['-w', '-F', word], paths);
}

function countWith(match: string[], paths: string[]): number {
	try {
		return execFileSync('git', ['-C', repoRoot, 'grep', '-I', '-o', ...match, '--', ...paths], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 }).split('\n').filter(Boolean).length;
	} catch {
		return 0;
	}
}

console.log(`${write ? 'Renaming' : 'Dry run: would rename'} the product ${current} → ${name} (${currentLower} → ${lower}) in product.json`);
console.log(changes.length ? changes.join('\n') : '  nothing to change');
console.log(`  kept (DEC-01): dataFolderName ${JSON.stringify(product.dataFolderName)}, sharedDataFolderName ${JSON.stringify(product.sharedDataFolderName)}, serverDataFolderName ${JSON.stringify(product.serverDataFolderName)}, the win32 application ids`);

console.log(`\nNot changed by this script; each is a step of docs/naming/RENAME-PROCEDURE.md:`);
console.log(`  ${count(`localize2?\\('[^']+', "[^"]*${current}`, 'src/vs/workbench/contrib/onyx', 'src/vs/platform/onyxRuntime')} user-facing strings in Onyx sources that contain "${current}" (command titles, dialogs)`);
console.log(`  ${count(current, 'extensions/theme-onyx/package.json', 'extensions/theme-onyx/package.nls.json')} occurrences in the theme extension's manifest (theme labels and ids, walkthrough text)`);
console.log(`  ${countWord(current, 'README.md', 'SECURITY.md', 'CONTRIBUTING.md', 'ROADMAP.md', 'docs/*.md', 'docs/release', '.github')} occurrences in the README, the top-level documents, docs/*.md and .github`);
console.log(`  the user data folder: ~/Library/Application Support/${current} becomes …/${name}; migrate or say that it is not migrated`);
console.log(`  the icons under resources/ (docs/brand/README.md), the hygiene allowlist in test/onyx/run-hygiene.mts, the e2e and smoke harnesses' app path`);
console.log(`  the repository rename and its redirects, the domain and the organisation: the owner's`);

if (write) {
	if (after !== before) {
		fs.writeFileSync(productFile, after);
		console.log(`\nproduct.json written. Rebuild, then run the module gate: nothing here was tested by this script.`);
	}
} else {
	console.log(`\nNothing was written. Add --write to apply the product.json changes.`);
}
