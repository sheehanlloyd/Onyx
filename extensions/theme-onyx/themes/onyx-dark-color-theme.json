		"peekViewResult.background": "#0E0E13",
		"peekViewTitle.background": "#131318",
		"peekViewResult.selectionBackground": "#8A63F52E",
		"peekViewEditor.matchHighlightBackground": "#E5B45B33",
		"peekViewResult.matchHighlightBackground": "#E5B45B33",

