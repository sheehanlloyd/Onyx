		"inputValidation.errorBackground": "#2B1518",
		"inputValidation.errorBorder": "#E36D6D",

		"dropdown.background": "#131318",
		"dropdown.foreground": "#D4D4DE",
		"dropdown.border": "#26262F",

		"checkbox.background": "#131318",
		"checkbox.border": "#26262F",

		"list.activeSelectionBackground": "#8A63F52E",
		"list.activeSelectionForeground": "#E4E4EE",
		"list.inactiveSelectionBackground": "#8A63F51A",
		"list.hoverBackground": "#15151C",
		"list.focusBackground": "#8A63F52E",
		"list.highlightForeground": "#A78BFA",
		"list.errorForeground": "#E36D6D",
		"list.warningForeground": "#E5B45B",
		"tree.indentGuidesStroke": "#26262F",

		"pickerGroup.foreground": "#A78BFA",
		"pickerGroup.border": "#26262F",
		"quickInput.background": "#131318",
		"quickInputList.focusBackground": "#8A63F52E",

		"scrollbar.shadow": "#00000000",
		"scrollbarSlider.background": "#8A63F521",
		"scrollbarSlider.hoverBackground": "#8A63F536",
		"scrollbarSlider.activeBackground": "#8A63F54D",

		"progressBar.background": "#8A63F5",

		"widget.border": "#26262F",
		"notifications.background": "#131318",
		"notifications.border": "#26262F",
		"notificationCenterHeader.background": "#131318",
		"notificationLink.foreground": "#A78BFA",

		"peekView.border": "#8A63F5",
