		"keybindingLabel.background": "#26262F80",
		"keybindingLabel.foreground": "#C8C8D4",
		"keybindingLabel.border": "#31313D",
		"keybindingLabel.bottomBorder": "#31313D",

		"chat.slashCommandForeground": "#A78BFA",
		"chat.avatarBackground": "#1B1B24",
		"chat.avatarForeground": "#C9B4FF",
		"chat.requestBorder": "#26262F",

		"inlineChat.background": "#131318",
		"inlineChat.border": "#26262F",

		"symbolIcon.classForeground": "#5AD0B8",
		"symbolIcon.interfaceForeground": "#5AD0B8",
		"symbolIcon.enumeratorForeground": "#5AD0B8",
		"symbolIcon.functionForeground": "#C9B4FF",
		"symbolIcon.methodForeground": "#C9B4FF",
		"symbolIcon.constructorForeground": "#C9B4FF",
		"symbolIcon.variableForeground": "#7B9CFF",
		"symbolIcon.fieldForeground": "#7B9CFF",
		"symbolIcon.constantForeground": "#E5B45B",
		"symbolIcon.propertyForeground": "#D4D4DE",
		"symbolIcon.snippetForeground": "#8B8B9E",
		"symbolIcon.keywordForeground": "#A78BFA",

		"onyx.accent": "#8A63F5",
		"onyx.ok": "#3FB68B",
		"onyx.warn": "#E5B45B",
		"onyx.error": "#E36D6D"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#5C5C6E", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#7FD1B9" }
		},
		{
			"scope": ["string.template meta.embedded", "meta.template.expression"],
			"settings": { "foreground": "#D4D4DE" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.other.placeholder"],
			"settings": { "foreground": "#E5B45B" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression"],
			"settings": { "foreground": "#A78BFA" }
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": { "foreground": "#9A9AB0" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#C9B4FF" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#5AD0B8" }
		},
		{
			"scope": ["variable", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#D4D4DE" }
		},
		{
			"scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
			"settings": { "foreground": "#B8C4E8" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#DEC9A8" }
		},
		{
			"scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
			"settings": { "foreground": "#A78BFA", "fontStyle": "italic" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#A78BFA" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#7FD1B9", "fontStyle": "italic" }
		},
		{
			"scope": ["punctuation.definition.tag"],
			"settings": { "foreground": "#6E6E85" }
		},
		{
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#C9B4FF", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#7FD1B9" }
		},
		{
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#A78BFA" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#3FB68B" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#E36D6D" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#E36D6D" }
		},
		{
			"scope": ["support.type.property-name.json", "support.type.property-name"],
			"settings": { "foreground": "#B8C4E8" }
		},
		{
			"scope": ["keyword.other.unit"],
			"settings": { "foreground": "#E5B45B" }
		},
		{
			"scope": ["constant.other.color"],
			"settings": { "foreground": "#5AD0B8" }
		},
		{
			"scope": ["meta.decorator", "punctuation.decorator"],
			"settings": { "foreground": "#C9B4FF", "fontStyle": "italic" }
		}
	],
	"semanticTokenColors": {
		"parameter": "#DEC9A8",
		"property": "#B8C4E8",
		"interface": "#5AD0B8",
		"class": "#5AD0B8",
		"enum": "#5AD0B8",
		"type": "#5AD0B8",
		"function": "#C9B4FF",
		"method": "#C9B4FF",
		"namespace": "#5AD0B8",
		"variable.readonly": "#E5B45B"
	}
}
