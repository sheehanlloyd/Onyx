		"gitDecoration.deletedResourceForeground": "#E36D6D",
		"gitDecoration.ignoredResourceForeground": "#4A4A5A",
		"gitDecoration.conflictingResourceForeground": "#E5B45B",

		"minimap.selectionHighlight": "#8A63F54D",
		"minimap.findMatchHighlight": "#E5B45B66",

