	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#9A9488",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#0B6E5E"
			}
		},
		{
			"scope": [
				"string.template meta.embedded",
				"meta.template.expression"
			],
			"settings": {
				"foreground": "#2C2A33"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other.placeholder"
			],
			"settings": {
				"foreground": "#8A5E14"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression"
			],
			"settings": {
				"foreground": "#5A3CD8"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#77717F"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function"
			],
			"settings": {
				"foreground": "#6B4EE6"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#0F8A76"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable"
			],
			"settings": {
				"foreground": "#2C2A33"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.other.object.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#3A5BB8"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#8A5A2B"
			}
		},
		{
			"scope": [
				"variable.language.this",
				"variable.language.self",
				"variable.language.super"
			],
			"settings": {
				"foreground": "#5A3CD8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#5A3CD8"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#0B6E5E",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#9A9488"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#5A3CD8",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code"
			],
			"settings": {
				"foreground": "#0B6E5E"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#5A3CD8"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#1B8A5A"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#C4314B"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#C4314B"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#3A5BB8"
			}
		},
		{
			"scope": [
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#8A5E14"
			}
		},
		{
			"scope": [
				"constant.other.color"
			],
			"settings": {
				"foreground": "#0F8A76"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator"
			],
			"settings": {
				"foreground": "#6B4EE6",
				"fontStyle": "italic"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": "#8A5A2B",
		"property": "#3A5BB8",
		"interface": "#0F8A76",
		"class": "#0F8A76",
		"enum": "#0F8A76",
		"type": "#0F8A76",
		"function": "#6B4EE6",
		"method": "#6B4EE6",
		"namespace": "#0F8A76",
		"variable.readonly": "#8A5E14"
	}
}
