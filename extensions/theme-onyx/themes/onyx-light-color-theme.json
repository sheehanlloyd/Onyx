		"list.focusBackground": "#6B4EE624",
		"list.highlightForeground": "#5A3CD8",
		"list.errorForeground": "#C4314B",
		"list.warningForeground": "#8A5E14",
		"tree.indentGuidesStroke": "#D2CABC",
