{
  "name": "theme-onyx",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "onyx",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "id": "Onyx Dark",
        "label": "%themeLabelDark%",
        "uiTheme": "vs-dark",
        "path": "./themes/onyx-dark-color-theme.json"
      },
      {
        "id": "Onyx Light",
        "label": "%themeLabelLight%",
        "uiTheme": "vs",
        "path": "./themes/onyx-light-color-theme.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "onyxWelcome",
        "title": "%walkthrough.title%",
        "featuredFor": ["**/*"],
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "onyx.runtime",
            "title": "%walkthrough.runtime.title%",
            "description": "%walkthrough.runtime.description%",
            "media": { "markdown": "media/runtime.md" }
          },
          {
            "id": "onyx.auto",
            "title": "%walkthrough.auto.title%",
            "description": "%walkthrough.auto.description%",
            "media": { "markdown": "media/auto.md" }
          },
          {
            "id": "onyx.controlPlane",
            "title": "%walkthrough.controlPlane.title%",
            "description": "%walkthrough.controlPlane.description%",
            "media": {
              "image": {
                "dark": "media/control-plane-dark.png",
                "light": "media/control-plane-light.png",
                "hc": "media/control-plane-dark.png",
                "hcLight": "media/control-plane-light.png"
              },
              "altText": "The Onyx control plane showing an agent run: routing, model turns, tool calls and the verification verdict"
            }
          },
          {
            "id": "onyx.models",
            "title": "%walkthrough.models.title%",
            "description": "%walkthrough.models.description%",
            "media": {
              "image": {
                "dark": "media/models-dark.png",
                "light": "media/models-light.png",
                "hc": "media/models-dark.png",
                "hcLight": "media/models-light.png"
              },
              "altText": "The Onyx model library listing installed and recommended models against this machine's unified memory"
            }
          },
          {
            "id": "onyx.review",
            "title": "%walkthrough.review.title%",
            "description": "%walkthrough.review.description%",
            "media": { "markdown": "media/review.md" }
          },
          {
            "id": "onyx.verification",
            "title": "%walkthrough.verification.title%",
            "description": "%walkthrough.verification.description%",
            "media": { "markdown": "media/verification.md" }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sheehanlloyd/cursor2.0.git"
  }
}
